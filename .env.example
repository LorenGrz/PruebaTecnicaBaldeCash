# Variables usadas por docker-compose.yml para levantar el proyecto completo
# (db + api + web) con un solo comando. Copiar a `.env` en la raíz:
#
#   cp .env.example .env
#
# Todas tienen default en el propio docker-compose.yml, así que este archivo
# es opcional: sirve para documentar qué se puede cambiar y para no tener que
# tocar el compose si hace falta otro puerto o credenciales distintas.

# --- PostgreSQL (servicio "db") ------------------------------------------
DB_USER=baldecash
DB_PASSWORD=baldecash
DB_NAME=baldecash
# Puerto publicado en el HOST para conectarse a Postgres desde afuera de
# Docker (por ejemplo con un cliente SQL). Dentro de la red de Compose la
# api siempre se conecta a "db:5432", sin importar este valor.
DB_PORT=5432

# --- API NestJS (servicio "api") ------------------------------------------
# Puerto de la API. Se usa igual para publicarlo en el host y para que la
# propia API escuche adentro del contenedor (PORT), así que cambiarlo alcanza
# para mover ambos lados a la vez.
PORT=3001
# Origen permitido para CORS: el frontend que usa el navegador del usuario.
WEB_ORIGIN=http://localhost:3000
# Tasa anual del financiamiento, en decimal (24% = 0.24).
TASA_ANUAL=0.24

# --- Frontend Next.js (servicio "web") ------------------------------------
# Puerto publicado en el host (y en el que escucha el contenedor) para el
# frontend.
WEB_PORT=3000
# URL de la API que usa el NAVEGADOR del usuario (Next la incrusta en el
# bundle del cliente en build time, es un ARG de web/Dockerfile). Por eso
# apunta al puerto publicado en el host (localhost:3001) y no al nombre del
# servicio "api" de la red interna de Compose, que el navegador no puede
# resolver. Si `web` necesitara llamar a la API desde el servidor de Next
# (Server Components/Route Handlers), esa llamada sí debería usar la URL
# interna http://api:3001/api en vez de esta variable. Ver docs/ARRANQUE.md.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# URL que usa el SERVIDOR de Next para llamar a la API (server components).
# Dentro de la red de Compose `localhost` es el propio contenedor de `web`, así
# que acá va el nombre del servicio. Sin el prefijo NEXT_PUBLIC_ para que no se
# filtre al bundle del navegador. Fuera de Docker se deja vacía: alcanza con
# NEXT_PUBLIC_API_URL.
API_URL_INTERNA=http://api:3001/api
